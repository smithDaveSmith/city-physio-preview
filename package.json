{
  "name": "cityphysio-redesign-concept",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial redesign concept for CityPhysio, Lucan. Static site generator with no runtime dependencies.",
  "scripts": {
    "build": "node build.js",
    "build:pages": "BASE=/cityphysio-concept node build.js",
    "verify": "node scripts/verify.js",
    "serve": "node -e \"const h=require('http'),f=require('fs'),p=require('path');const M={'.html':'text/html;charset=utf-8','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml','.txt':'text/plain'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);let x=p.join('docs',u);if(u.endsWith('/'))x=p.join(x,'index.html');if(!f.existsSync(x)){r.writeHead(404);return r.end(f.readFileSync('docs/404.html'));}r.writeHead(200,{'content-type':M[p.extname(x)]||'text/plain'});f.createReadStream(x).pipe(r)}).listen(8080,()=>console.log('http://localhost:8080'))\"",
    "verify:portable": "node scripts/verify-portable.js",
    "plates": "node tools/plates.js"
  },
  "devDependencies": {
    "playwright": "^1.49.1"
  },
  "engines": {
    "node": ">=18"
  }
}